# Copy to .env (same folder) and fill in. .env is git-ignored: never commit it.
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# Folder with <Topic>/<lesson>/ video folders (kept out of git)
SHORTS_DIR=~/Documents/Shorts

# Set to true only after Google approves the YouTube API audit.
# Uploads from an unaudited project are locked private permanently.
YT_AUDIT_APPROVED=false

RELEASE_TIME=19:00
TIMEZONE=Asia/Jerusalem
EXPECTED_CHANNEL=The Code Professor
